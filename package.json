{
  "name": "ang2-conduit",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "./node_modules/.bin/ng",
    "docker": "docker build --build-arg NES_AUTH_TOKEN=$npm_config_nes_auth_token -t angular-v9 . && (ids=$(docker ps -aq --filter publish=4200); [ -n \"$ids\" ] && docker rm -f $ids; true) && docker run -d --rm --name angular-v9 -p 4200:4200 angular-v9",
    "docker:stop": "ids=$(docker ps -aq --filter publish=4200); [ -n \"$ids\" ] && docker rm -f $ids || echo 'nothing on 4200'",
    "start": "ng serve",
    "build": "ng build --configuration production  --base-href ./ && cp CNAME dist/CNAME",
    "build-prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint --force",
    "e2e": "ng e2e",
    "clean": "rm -rf node_modules dist package-lock.json .angular/cache coverage out-tsc tmp",
    "postinstall": "npx ngnes"
  },
  "pre-commit": [
    "lint"
  ],
  "engines": {
    "node": "^12.11.1"
  },
  "private": true,
